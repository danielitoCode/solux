VITE_SUPABASE_URL=https://project_url.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_key

# Cloudinary (upload unsigned — solo cloud name + upload preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# URL pública canónica (sin barra final) — SEO, canonical, sitemap
VITE_SITE_URL=https://tu-dominio.com

# ---------------------------------------------------------------------------
# Edge Function notify-whatsapp (CallMeBot)
# NO uses prefijo VITE_ — no van al frontend.
# Configúralas como Secrets en Supabase:
#   Dashboard → Edge Functions → Secrets
#   o: supabase secrets set CALLMEBOT_PHONE="+53..."
# ---------------------------------------------------------------------------
CALLMEBOT_PHONE=+53XXXXXXXXX
CALLMEBOT_APIKEY=tu_apikey_de_callmebot
# Opcional pero recomendado: valida header x-notify-secret en la function
NOTIFY_WEBHOOK_SECRET=cambia_este_secreto_largo
